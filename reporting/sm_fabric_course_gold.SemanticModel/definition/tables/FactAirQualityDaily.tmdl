table FactAirQualityDaily
	lineageTag: 767fc310-44e4-4dd9-88eb-d5ebe1fe0102
	sourceLineageTag: [dbo].[FactAirQualityDaily]

	measure 'Weighted Avg AQ' =
			
			IF(
			    DISTINCTCOUNT(DimSensors[parameter]) = 1 && DISTINCTCOUNT(DimSensors[units]) = 1,
			    DIVIDE(SUMX(FactAirQualityDaily, FactAirQualityDaily[avg_value] * FactAirQualityDaily[observed_count]), SUM(FactAirQualityDaily[observed_count]))
			)
		formatString: #,0.00
		lineageTag: f115050c-c1a4-4b31-9a83-0da0b7d4eebc

		changedProperty = Name

		changedProperty = FormatString

	measure 'Peak Max AQ' =
			
			IF(
			    DISTINCTCOUNT(DimSensors[parameter]) = 1 && DISTINCTCOUNT(DimSensors[units]) = 1,
			    MAX(FactAirQualityDaily[max_value])
			)
		formatString: #,0.00
		lineageTag: ad99be9b-410b-40cb-9c33-403087c0f674

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Coverage %' = DIVIDE(AVERAGE(FactAirQualityDaily[percent_coverage]), 100)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: f205cd11-e3f6-4f11-b5fe-3b7a48d02d1f

		changedProperty = Name

		changedProperty = FormatString

	measure 'Weekday vs Weekend AQ %' =
			
			VAR WeekdayAQ = CALCULATE([Weighted Avg AQ], DimDate[is_weekend] = FALSE())
			VAR WeekendAQ = CALCULATE([Weighted Avg AQ], DimDate[is_weekend] = TRUE())
			RETURN
			IF(
			    NOT ISBLANK(WeekdayAQ) && NOT ISBLANK(WeekendAQ),
			    DIVIDE(WeekdayAQ - WeekendAQ, WeekendAQ)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1ab1ec08-ab96-4889-b141-8de70181e2c6

		changedProperty = Name

		changedProperty = FormatString

